<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_sim" default="false" />
    
    <ros2_control name="RobotSystem" type="system">
        
        <xacro:if value="$(arg use_sim)">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
        </xacro:if>

        <xacro:unless value="$(arg use_sim)">
            <hardware>
                <plugin>so101_hardware/STS3215HardwareInterface</plugin>
                <param name="usb_port">/dev/ttyUSB0</param>
                <param name="baud_rate">1000000</param>
            </hardware>
        </xacro:unless>

        <joint name="1">
            <param name="motor_id">1</param>
            <command_interface name="position">
                <param name="min">-1.91986</param>
                <param name="max">1.91986</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="2">
            <param name="motor_id">2</param>
            <command_interface name="position">
                <param name="min">-2.0</param>
                <param name="max">2.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="3">
            <param name="motor_id">3</param>
            <command_interface name="position">
                <param name="min">-1.74</param>
                <param name="max">1.8</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="4">
            <param name="motor_id">4</param>
            <command_interface name="position">
                <param name="min">-1.65806</param>
                <param name="max">1.65806</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="5">
            <param name="motor_id">5</param>
            <command_interface name="position">
                <param name="min">-2.79253</param>
                <param name="max">2.79253</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="6">
            <param name="motor_id">6</param>
            <command_interface name="position">
                <param name="min">-0.174533</param>
                <param name="max">1.74533</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

    </ros2_control>

</robot>